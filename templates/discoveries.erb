<section class="page-hero shell">
  <span class="section-number">01 / Work</span>
  <h1>Things I found<br><em>by looking closer.</em></h1>
  <p>Public vulnerability work across browsers and mobile platforms. Each item points to its canonical CVE and vendor advisory.</p>
</section>

<section class="archive-layout shell">
  <aside class="archive-aside">
    <span class="hand-note">the public shelf</span>
    <div class="archive-count"><strong><%= @discoveries.length %></strong><span>coordinated CVEs</span></div>
    <p>Only disclosed and publicly verifiable work lives here.</p>
  </aside>
  <div class="work-list full-list">
    <% @discoveries.each_with_index do |discovery, index| %>
      <%= discovery_row(discovery, index: index + 1) %>
    <% end %>
  </div>
</section>

<article class="article-shell">
  <header class="article-hero shell">
    <div class="article-heading">
      <a class="breadcrumb" href="<%= base('/blog/') %>">← Back to blog</a>
      <div class="card-meta article-meta">
        <span><%= h(@article['label']) %></span>
        <span><%= h(format_date(@article['date'])) %></span>
        <span><%= @article['reading_time'] %> min read</span>
      </div>
      <h1><%= h(@article['title']) %></h1>
      <p><%= h(@article['excerpt']) %></p>
      <div class="article-byline">
        <span class="byline-mark" aria-hidden="true">JR</span>
        <span><strong>Jody Ritonga</strong><small>Security researcher · Tangerang, Indonesia</small></span>
      </div>
    </div>

    <figure class="article-cover">
      <span class="tape" aria-hidden="true"></span>
      <img src="<%= base(@article['cover']) %>" alt="<%= h(@article['cover_alt']) %>" width="<%= @article['cover_width'] %>" height="<%= @article['cover_height'] %>" fetchpriority="high">
      <figcaption><%= h(@article['cover_caption']) %></figcaption>
    </figure>
  </header>

  <div class="article-rule shell" aria-hidden="true"></div>

  <div class="article-layout shell">
    <aside class="article-aside">
      <span class="hand-note">report card</span>
      <dl>
        <div><dt>Affected build</dt><dd><%= h(@article['affected_version']) %></dd></div>
        <div><dt>Program</dt><dd><%= h(@article['program']) %></dd></div>
        <div><dt>Status</dt><dd><span class="status-dot" aria-hidden="true"></span><%= h(@article['status']) %></dd></div>
      </dl>
      <nav class="article-toc" aria-label="On this page">
        <span>On this page</span>
        <a href="#where-it-started">Where it started</a>
        <a href="#one-dangerous-field">One dangerous field</a>
        <a href="#the-chain">The full chain</a>
        <a href="#proving-it">Proving it</a>
        <a href="#impact">Impact</a>
        <a href="#disclosure">Disclosure</a>
      </nav>
    </aside>

    <div class="article-body"><%= @article_content %></div>
  </div>
</article>

<section class="article-end">
  <div class="shell article-end-inner">
    <span class="hand-note">That’s the whole chain.</span>
    <a class="button primary" href="<%= base('/blog/') %>">Back to the blog <span>→</span></a>
  </div>
</section>

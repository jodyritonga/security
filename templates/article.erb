<article class="article-shell shell">
  <header class="article-header">
    <a class="breadcrumb" href="<%= @article['collection'] == 'notes' ? base('/notes/') : base('/research/') %>">← <%= @article['collection'] == 'notes' ? 'Field notes' : 'Research archive' %></a>
    <span class="eyebrow"><%= h(@article['label']) %></span>
    <h1><%= h(@article['title']) %></h1>
    <p><%= h(@article['excerpt']) %></p>
    <div class="article-byline"><span>Jody Ritonga</span><span><%= h(format_date(@article['date'])) %></span><span><%= @article['reading_time'] %> min read</span></div>
  </header>

  <div class="article-layout">
    <aside class="article-aside">
      <span class="mini-label">Article record</span>
      <div><small>Originally published</small><strong><%= h(@article['original_host']) %></strong></div>
      <div><small>Archive status</small><strong>Locally preserved</strong></div>
      <div class="tag-stack"><small>Tags</small><% @article['tags'].each do |tag| %><span><%= h(display_tag(tag)) %></span><% end %></div>
      <a class="text-link" href="<%= h(@article['original_url']) %>" target="_blank" rel="noreferrer">Original publication ↗</a>
    </aside>
    <div class="article-body"><%= @article_content %></div>
  </div>
</article>

<section class="related-section shell">
  <div class="section-heading compact-heading"><div><span class="eyebrow">Continue reading</span><h2>More from the archive.</h2></div></div>
  <div class="research-grid related-grid"><% @related_articles.each do |article| %><%= article_card(article, compact: true) %><% end %></div>
</section>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h(@page_title) %></title>
    <meta name="description" content="<%= h(@page_description) %>">
    <meta name="author" content="RETAK Security">
    <meta name="theme-color" content="#07070c">
    <link rel="icon" type="image/svg+xml" href="<%= base('/assets/images/favicon.svg') %>">
    <link rel="canonical" href="<%= absolute(@canonical_path) %>">
    <link rel="alternate" type="application/rss+xml" title="RETAK Security CVE Record" href="<%= base('/feed.xml') %>">
    <meta property="og:type" content="<%= @body_class == 'article-page' ? 'article' : 'website' %>">
    <meta property="og:title" content="<%= h(@page_title) %>">
    <meta property="og:description" content="<%= h(@page_description) %>">
    <meta property="og:url" content="<%= absolute(@canonical_path) %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= h(@page_title) %>">
    <meta name="twitter:description" content="<%= h(@page_description) %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= base('/assets/css/abyss.css') %>">
    <script defer src="<%= base('/assets/js/site.js') %>"></script>
    <script defer src="<%= base('/assets/js/fracture-3d.js') %>"></script>
  </head>
  <body class="<%= h(@body_class) %>">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="ambient-field" aria-hidden="true"><i></i><i></i><i></i></div>
    <header class="site-header">
      <div class="shell header-inner">
        <div class="site-brand">
          <button class="brand-relic" type="button" data-crack-level="0" aria-label="Cracked stone. Open three fractures to wake what is inside." aria-controls="dragon-reveal" aria-expanded="false">
            <svg class="brand-mark" viewBox="0 0 72 72" aria-hidden="true">
              <defs>
                <clipPath id="relic-stone-clip"><path d="M13 7 34 2l22 6 10 18-4 25-18 16-24-3L7 47 5 23Z"/></clipPath>
              </defs>
              <path class="mark-stone" d="M13 7 34 2l22 6 10 18-4 25-18 16-24-3L7 47 5 23Z"/>
              <g class="mark-fragments" clip-path="url(#relic-stone-clip)">
                <path class="mark-fragment fragment-nw" d="M-4-5h40l-7 25-13-7L4 24Z"/>
                <path class="mark-fragment fragment-ne" d="M36-5h42v24L39 31l-6-11Z"/>
                <path class="mark-fragment fragment-w" d="M-4 14l33 6 5 9-12 14 6 9-32-5Z"/>
                <path class="mark-fragment fragment-e" d="m39 29 39-13v36l-44-1-6-8Z"/>
                <path class="mark-fragment fragment-sw" d="m-4 46 32 6-10 27H-4Z"/>
                <path class="mark-fragment fragment-se" d="m34 51 44-2v30H18Z"/>
              </g>
              <path class="mark-fissure-glow" d="M36 1 30 20l4 9-11 14 5 9-8 19M30 20 16 14M39 29l17-9M23 43 8 39M28 52l20 11"/>
              <path class="mark-crack" d="M35 0 29 20 33 28 22 43 27 51 18 72h8l8-21-6-8 11-14-5-9 7-20ZM31 18 18 12l-2 5 15 7ZM36 25l18-8 2 5-18 10ZM25 39 9 36l-1 5 17 5ZM28 48l22 11-3 6-21-12Z"/>
            </svg>
            <span class="relic-counter" aria-hidden="true">0 / 3</span>
          </button>
          <a class="brand-copy" href="<%= base('/') %>" aria-label="RETAK Security home"><strong>RETAK</strong><small>Security / Indonesia</small></a>
          <span class="relic-status" aria-live="polite"></span>
        </div>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Menu</button>
        <nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
          <%= nav_link('CVEs', '/discoveries/', 'discoveries') %>
          <%= nav_link('Method', '/method/', 'method') %>
          <%= nav_link('About', '/about/', 'about') %>
        </nav>
      </div>
    </header>
    <div class="dragon-reveal" id="dragon-reveal" role="dialog" aria-modal="true" aria-labelledby="dragon-reveal-title" aria-hidden="true">
      <button class="dragon-dismiss" type="button" aria-label="Reseal the fracture">Reseal <span>×</span></button>
      <div class="dragon-reveal__field" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="dragon-portal" aria-hidden="true"><i></i><i></i><i></i></div>
      <img class="dragon-figure" src="<%= base('/assets/images/retak-dragon-3d.webp') %>" width="1280" height="853" alt="A horned obsidian and violet dragon with glowing aqua fractures, spread wings, claws, and a serpentine tail">
      <div class="dragon-reveal__copy">
        <span>Fracture sequence · 03 / 03</span>
        <strong id="dragon-reveal-title">The boundary is awake.</strong>
        <small>Click the void or press Esc to reseal.</small>
      </div>
    </div>
    <main id="content"><%= @content %></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <span class="eyebrow">RETAK / Security Research</span>
          <p>Independent security research from the edge of the trust boundary.</p>
        </div>
        <div class="footer-links">
          <a href="mailto:jodyritonga@gmail.com">Email</a>
          <a href="https://github.com/jodyritonga" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/jodyritonga" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="<%= base('/discoveries/') %>">CVE record</a>
        </div>
        <div class="footer-meta">Tangerang, Indonesia<br>Independent · Responsible disclosure</div>
      </div>
    </footer>
  </body>
</html>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h(@page_title) %></title>
    <meta name="description" content="<%= h(@page_description) %>">
    <meta name="author" content="Jody Jeremi Hadrian Ritonga">
    <meta name="theme-color" content="#080c0e">
    <link rel="canonical" href="<%= absolute(@canonical_path) %>">
    <link rel="alternate" type="application/rss+xml" title="Jody Ritonga Security Research" href="<%= base('/feed.xml') %>">
    <meta property="og:type" content="<%= @body_class == 'article-page' ? 'article' : 'website' %>">
    <meta property="og:title" content="<%= h(@page_title) %>">
    <meta property="og:description" content="<%= h(@page_description) %>">
    <meta property="og:url" content="<%= absolute(@canonical_path) %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= h(@page_title) %>">
    <meta name="twitter:description" content="<%= h(@page_description) %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600;700;800&family=Patrick+Hand&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= base('/assets/css/site.css') %>">
    <script defer src="<%= base('/assets/js/site.js') %>"></script>
  </head>
  <body class="<%= h(@body_class) %>">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="site-brand" href="<%= base('/') %>" aria-label="Jody Ritonga security research home">
          <span class="brand-mark">JR</span>
          <span class="brand-copy"><strong>Jody Ritonga</strong><small>Security Research</small></span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Menu</button>
        <nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
          <%= nav_link('Research', '/research/', 'research') %>
          <%= nav_link('Discoveries', '/discoveries/', 'discoveries') %>
          <%= nav_link('Notes', '/notes/', 'notes') %>
          <%= nav_link('Method', '/method/', 'method') %>
          <%= nav_link('About', '/about/', 'about') %>
        </nav>
      </div>
    </header>
    <main id="content"><%= @content %></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <span class="eyebrow">Independent research archive</span>
          <p>Browser, mobile, and web application security. LLM-accelerated, human-verified, impact-proven.</p>
        </div>
        <div class="footer-links">
          <a href="mailto:jodyritonga@gmail.com">Email</a>
          <a href="https://github.com/jodyritonga" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/jodyritonga" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="<%= base('/feed.xml') %>">RSS</a>
        </div>
        <div class="footer-meta">Tangerang, Indonesia<br>Responsible disclosure</div>
      </div>
    </footer>
  </body>
</html>
